<%
// Quarto escapes raw HTML that reaches the page through a JS variable, but
// passes literal markup written in the template. So icons are inlined below
// rather than looked up from a map, and the author's own name is bolded by
// splitting the plain-text author string around it.
//
// Also: template output runs through markdown, so no line may begin with
// four or more spaces or it turns into an indented code block.
%>
<% for (const item of items) { %>
<%
const nameParts = (item.authors || '').split('Serebrennikov, D.');
// APA 7: ampersand before the final author, "in press" for unpublished work,
// and the DOI or landing URL appended when one exists.
// Every author is itself "Surname, I.", so the separator between authors is
// the comma that follows an initial's period — not just any comma.
const authorList = (item.authors || '').split(/(?<=\.)\s*,\s*/).filter(Boolean);
let apaAuthors = authorList.length > 1
? authorList.slice(0, -1).join(', ') + ', & ' + authorList[authorList.length - 1]
: (authorList[0] || '');
const apaYear = /forthcoming|in press/i.test(item.year || '') ? 'in press' : (item.year || 'n.d.');
let apa = apaAuthors + ' (' + apaYear + '). ' + (item.title || '') + '. ' + (item.venue || '');
if (item.detail) { apa += ', ' + item.detail; }
apa += '.';
if (item.publisher) { apa += ' ' + item.publisher + '.'; }
const citeLink = (item.links || []).find(l => l.icon === 'paper' || l.icon === 'report' || l.icon === 'data');
if (citeLink) { apa += ' ' + citeLink.href; }
// Straight quotes inside a title would terminate the data-apa attribute.
let quoteToggle = 0;
apa = apa.replace(/"/g, function () { return (quoteToggle++ % 2 === 0) ? '“' : '”'; });
%>
<div class="pub-entry<%= item.thumbnail ? ' has-thumb' : '' %>">
<div class="pub-body">
<div class="pub-title"><%= item.title %></div>
<div class="pub-authors"><%= nameParts[0] %><% if (nameParts.length > 1) { %><strong>Serebrennikov, D.</strong><%= nameParts[1] %><% } %></div>
<div class="pub-meta"><em><%= item.venue %></em><% if (item.detail) { %> · <%= item.detail %><% } %> · <%= item.year %><% if (item.publisher) { %> · <%= item.publisher %><% } %><% if (item.note) { %> · <%= item.note %><% } %></div>
<div class="pub-links"><% for (const link of (item.links || [])) { %><a href="<%= link.href %>"><% if (link.icon === 'paper') { %><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"/><path d="M9 9h1M9 13h6M9 17h6"/></svg><% } else if (link.icon === 'data') { %><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg><% } else if (link.icon === 'code') { %><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 9l-3 3 3 3"/><path d="M16 9l3 3-3 3"/><path d="M13.5 7l-3 10"/></svg><% } else if (link.icon === 'report') { %><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"/><path d="M9 17v-4M12 17v-6M15 17v-2"/></svg><% } %><%= link.label %></a><% } %><button class="pub-cite" type="button" data-apa="<%= apa %>" aria-label="Copy the APA citation for this item"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>cite</button></div>
</div>
<% if (item.thumbnail) { %>
<div class="pub-thumb"><img src="<%= item.thumbnail %>" alt="<%= item.thumbnailAlt || 'Figure from the paper' %>"></div>
<% } %>
</div>
<% } %>
